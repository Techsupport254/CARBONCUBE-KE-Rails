# Copy this file to .env and fill in the real values for your environment.
# Do NOT commit real .env files to the repository.
RAILS_ENV=development
BACKEND_INTERNAL_URL=
DATABASE_URL=
REDIS_URL=

# Rails secrets (generate with `bin/rails secret`)
SECRET_KEY_BASE=

# Active Record Encryption Keys (Messages at rest encryption)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# JWT auth secret (same as or separate from SECRET_KEY_BASE)
JWT_SECRET=

# Internal API token for backend -> call-center / internal job authentication
ADMIN_API_TOKEN=
# Legacy alias for the above (kept for compatibility, prefer ADMIN_API_TOKEN)
INTERNAL_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Brevo email
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=

# M-Pesa
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENVIRONMENT=

# Google OAuth (buyer/seller mobile + web login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# Google Maps (geocoding / seller locations)
GOOGLE_MAPS_API_KEY=

# Google Analytics 4 / Merchant
GA_PROPERTY_ID=
GOOGLE_MERCHANT_KEY_PATH=config/google-merchant-key.json

# Groq / Gemini (content moderation / AI)
GROQ_API_KEY=
GEMINI_API_KEY=

# Sentry / monitoring (optional)
SENTRY_DSN=
