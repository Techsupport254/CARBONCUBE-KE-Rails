# Copy this file to .env and fill in the real values for your environment.
# Do NOT commit real .env files to the repository.
RAILS_ENV=development
BACKEND_INTERNAL_URL=
DATABASE_URL=
REDIS_URL=
REDIS_SESSION_URL=

# WebSocket / Action Cable
WEBSOCKET_ENABLED=true

# Logging
RAILS_LOG_LEVEL=info

# Deployment / hosts
# HOST is the canonical server host (e.g. anko.carboncube-ke.com)
HOST=
# Comma-separated list of extra hosts Rails should allow (e.g. localhost, 127.0.0.1, preview-*.vercel.app)
RAILS_ALLOWED_HOSTS=
# Extra CORS origins allowed to call the API (comma-separated)
CORS_ADDITIONAL_ORIGINS=
# Serve static files from Rails (set for Render/Heroku or leave blank for nginx)
RAILS_SERVE_STATIC_FILES=
# Set when running on Render so static file serving is enabled
RENDER=

# Rails secrets (generate with `bin/rails secret`)
SECRET_KEY_BASE=

# Active Record Encryption Keys (Messages at rest encryption)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# JWT auth secret (same as or separate from SECRET_KEY_BASE)
JWT_SECRET=

# Internal API token for backend -> call-center / internal job authentication
ADMIN_API_TOKEN=
# Legacy alias for the above (kept for compatibility, prefer ADMIN_API_TOKEN)
INTERNAL_API_KEY=

# Call-center / campaign settings
CALL_CENTER_API_URL=http://localhost:3000
# Delay in seconds between live campaign sends (e.g. 0.1)
CAMPAIGN_THROTTLE_DELAY=0.1

# URLs used when generating links in emails / QR codes
FRONTEND_URL=https://carboncube-ke.com
NEXT_PUBLIC_SITE_URL=https://carboncube-ke.com
REACT_APP_SITE_URL=https://carboncube-ke.com
PUBLIC_URL=https://carboncube-ke.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
UPLOAD_PRESET=

# Brevo email
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=

# M-Pesa
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENVIRONMENT=

# Google OAuth (buyer/seller mobile + web login)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Apple OAuth
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=

# WhatsApp Cloud API
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_WABA_ID=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_SERVICE_URL=https://carboncube-ke.com
WHATSAPP_SERVICE_PORT=3000
WHATSAPP_NOTIFICATIONS_ENABLED=false

# Google Maps (geocoding / seller locations)
GOOGLE_MAPS_API_KEY=

# Google Analytics 4 / Merchant
GA4_PROPERTY_ID=
GA4_OAUTH_CLIENT_ID=
GA4_OAUTH_CLIENT_SECRET=
GA4_OAUTH_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=config/google-merchant-key.json
GOOGLE_MERCHANT_ACCOUNT_ID=
GOOGLE_MERCHANT_SYNC_ENABLED=false

# Groq / Gemini (content moderation / AI)
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
FLASH_SALE_DEBUG_LOGS=false

# Sentry / monitoring (optional)
SENTRY_DSN=
NEXT_PUBLIC_UPTIME_KUMA_URL=

# Mobile / release gating
PILOT_PHASE_ENABLED=false
MOBILE_RELEASE_TOKEN=

# Firebase / push notifications
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Meta (WhatsApp webhooks)
META_APP_SECRET=
