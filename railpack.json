{
  "exclude": [
    "**/node_modules",
    "**/.git",
    "**/log",
    "**/scratch",
    "**/vendor/bundle",
    "**/test",
    "**/spec",
    "**/coverage",
    "config/master.key"
  ],
  "steps": {
    "prune:node": {
      "commands": ["rm -rf node_modules && bun install --production"]
    },
    "build_emails": {
      "inputs": [{ "step": "build" }],
      "commands": [
        "bun install --frozen-lockfile",
        "./node_modules/.bin/react-email-rails-build"
      ],
      "deployOutputs": [{ "include": ["tmp/react-email-rails"] }]
    }
  }
}
