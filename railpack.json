{
  "steps": {
    "prune:node": {
      "commands": ["rm -rf node_modules && bun install --production"]
    },
    "build_emails": {
      "inputs": [{ "step": "build" }, { "step": "install:node" }],
      "commands": ["./node_modules/.bin/react-email-rails-build"],
      "deployOutputs": [{ "include": ["tmp/react-email-rails"] }]
    }
  }
}
