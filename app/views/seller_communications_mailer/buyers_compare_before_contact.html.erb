<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Help Buyers Make Faster Decisions - Carbon Cube Kenya</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    html, body {
      margin: 0 auto !important;
      padding: 0 !important;
      height: 100% !important;
      width: 100% !important;
      background-color: #f1f5f9;
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    * { box-sizing: border-box; }
    table { border-spacing: 0 !important; border-collapse: collapse !important; margin: 0 auto !important; }
    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid #e2e8f0;
    }
    @media screen and (max-width: 600px) {
      .email-container { width: 100% !important; border-radius: 0 !important; }
      .content-padding { padding: 24px 20px !important; }
      .header-padding { padding: 20px 20px !important; }
      .heading-text { font-size: 20px !important; line-height: 28px !important; }
    }
  </style>
</head>
<body style="background-color: #f1f5f9; padding: 30px 0;">
  <table role="presentation" width="100%" height="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f1f5f9;">
    <tr>
      <td align="center" valign="top">
        <table role="presentation" class="email-container" width="600" cellpadding="0" cellspacing="0" border="0">
          
          <!-- BRAND HEADER -->
          <tr>
            <td class="header-padding" style="background-color: #0b1324; padding: 28px 36px; border-bottom: 3px solid #f59e0b;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td width="42" valign="middle">
                    <img src="https://carboncube-ke.com/logo.png" width="36" height="36" alt="Carbon Cube Kenya" style="display: block; border-radius: 6px;" />
                  </td>
                  <td valign="middle" style="padding-left: 12px;">
                    <div style="font-size: 18px; font-weight: 900; color: #ffffff; letter-spacing: 0.8px; text-transform: uppercase;">
                      CARBON CUBE
                    </div>
                    <div style="font-size: 11px; font-weight: 700; color: #94a3b8; letter-spacing: 1px; text-transform: uppercase; margin-top: 2px;">
                      KENYA • SELLER INSIGHTS
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- MAIN CONTENT BODY -->
          <tr>
            <td class="content-padding" style="padding: 36px 36px 20px 36px; background-color: #ffffff;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                
                <!-- EYEBROW BADGE -->
                <tr>
                  <td style="padding-bottom: 12px;">
                    <span style="display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: #d97706; background-color: #fef3c7; padding: 4px 12px; border-radius: 20px;">
                      ⚡ SELLER TIP OF THE WEEK
                    </span>
                  </td>
                </tr>

                <!-- MAIN HEADING -->
                <tr>
                  <td style="padding-bottom: 20px;">
                    <h1 class="heading-text" style="margin: 0; font-size: 24px; font-weight: 800; color: #0f172a; line-height: 32px; letter-spacing: -0.3px;">
                      Help Buyers Make Faster Decisions
                    </h1>
                  </td>
                </tr>

                <!-- SALUTATION & INTRO -->
                <tr>
                  <td style="padding-bottom: 16px; font-size: 16px; font-weight: 700; color: #1e293b;">
                    Dear <%= @first_name.presence || @seller_name.presence || 'Seller' %>,
                  </td>
                </tr>
                <tr>
                  <td style="padding-bottom: 24px; font-size: 15px; line-height: 25px; color: #475569;">
                    Many buyers compare several products before deciding who to contact. The more complete and consistent your product information is across your listings, the easier it is for buyers to choose your business.
                  </td>
                </tr>

                <!-- CHECKLIST CARD -->
                <tr>
                  <td style="padding-bottom: 24px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px;">
                      <tr>
                        <td style="padding-bottom: 16px; font-size: 13px; font-weight: 800; color: #0f172a; text-transform: uppercase; letter-spacing: 0.8px;">
                          📋 This week, take a few minutes to:
                        </td>
                      </tr>

                      <!-- ITEM 1 -->
                      <tr>
                        <td style="padding-bottom: 14px;">
                          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td valign="top" width="28">
                                <div style="background-color: #dbeafe; color: #1d4ed8; width: 22px; height: 22px; border-radius: 50%; text-align: center; line-height: 22px; font-size: 12px; font-weight: 800;">1</div>
                              </td>
                              <td valign="top" style="padding-left: 8px; font-size: 14px; line-height: 22px; color: #334155;">
                                <strong style="color: #0f172a;">Review for consistency:</strong> Review your product information for consistency across all your active listings.
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>

                      <!-- ITEM 2 -->
                      <tr>
                        <td style="padding-bottom: 14px;">
                          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td valign="top" width="28">
                                <div style="background-color: #dbeafe; color: #1d4ed8; width: 22px; height: 22px; border-radius: 50%; text-align: center; line-height: 22px; font-size: 12px; font-weight: 800;">2</div>
                              </td>
                              <td valign="top" style="padding-left: 8px; font-size: 14px; line-height: 22px; color: #334155;">
                                <strong style="color: #0f172a;">Check pricing:</strong> Check that prices match your current selling prices.
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>

                      <!-- ITEM 3 -->
                      <tr>
                        <td>
                          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td valign="top" width="28">
                                <div style="background-color: #dbeafe; color: #1d4ed8; width: 22px; height: 22px; border-radius: 50%; text-align: center; line-height: 22px; font-size: 12px; font-weight: 800;">3</div>
                              </td>
                              <td valign="top" style="padding-left: 8px; font-size: 14px; line-height: 22px; color: #334155;">
                                <strong style="color: #0f172a;">Clean up inventory:</strong> Remove products you no longer offer.
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>

                    </table>
                  </td>
                </tr>

                <!-- VALUE IMPACT BANNER -->
                <tr>
                  <td style="padding-bottom: 28px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 0 8px 8px 0; padding: 14px 18px;">
                      <tr>
                        <td style="font-size: 14px; line-height: 22px; color: #78350f;">
                          💡 <strong>Why it matters:</strong> Small improvements can make your shop easier to navigate and more appealing to buyers.
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- CTA BUTTON -->
                <tr>
                  <td style="padding-bottom: 32px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td align="center" style="background-color: #f59e0b; border-radius: 10px;">
                          <a href="https://carboncube-ke.com/seller/dashboard?utm_source=email_1&utm_medium=email&utm_campaign=buyers_compare" target="_blank" style="display: inline-block; padding: 14px 28px; font-size: 16px; font-weight: 800; color: #0f172a; text-decoration: none; border-radius: 10px;">
                            Visit Seller Dashboard &rarr;
                          </a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- SIGN OFF -->
                <tr>
                  <td style="padding-bottom: 12px; font-size: 15px; line-height: 24px; color: #475569;">
                    Regards,
                  </td>
                </tr>
                <tr>
                  <td style="padding-bottom: 12px; font-size: 16px; font-weight: 800; color: #0f172a;">
                    Carbon Cube Kenya
                  </td>
                </tr>

              </table>
            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="background-color: #f8fafc; border-top: 1px solid #e2e8f0; padding: 24px 36px; text-align: center;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="font-size: 12px; line-height: 20px; color: #64748b;">
                    <strong style="color: #334155;">Carbon Cube Kenya</strong> • 9th Floor, CMS Africa, Nairobi, Kenya
                  </td>
                </tr>
                <tr>
                  <td style="padding-top: 8px; font-size: 12px; color: #94a3b8;">
                    <a href="https://carboncube-ke.com" style="color: #d97706; font-weight: 600; text-decoration: underline;">carboncube-ke.com</a>
                  </td>
                </tr>
                <tr>
                  <td style="padding-top: 16px; font-size: 11px; color: #cbd5e1;">
                    &copy; <%= Time.current.year %> Carbon Cube Kenya. All rights reserved.
                  </td>
                </tr>
              </table>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
