<mjml>
  <mj-head>
    <mj-title>Build Trust through Accurate Listings | Carbon Cube Kenya</mj-title>
    <mj-font name="Outfit" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" />
    <mj-attributes>
      <mj-all
        font-family="Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        color="#334155"
        padding="0px"
      />
      <mj-text font-size="16px" line-height="26px" color="#334155" padding="0px" />
      <mj-section padding="0px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#ffffff" width="600px">
    <mj-section padding="40px 20px">
      <mj-column>
        <!-- Logo for branding -->
        <mj-image
          src="https://carboncube-ke.com/logo.png"
          width="32px"
          alt="Carbon Cube Kenya"
          align="left"
          padding-bottom="24px"
        />

        <mj-text padding-bottom="16px" font-weight="700" font-size="20px" line-height="28px" color="#1e293b">
          Build Trust through Accurate Listings
        </mj-text>

        <mj-text padding-bottom="16px">Dear {{full_name}},</mj-text>

        <mj-text padding-bottom="16px">
          Trust begins with honest product information.
        </mj-text>

        <mj-text padding-bottom="8px">
          To help buyers make informed decisions:
        </mj-text>

        <!-- Bullet List -->
        <mj-text padding-left="16px" padding-bottom="8px">
          • <strong>Use genuine product photos.</strong> Show the real item from multiple angles.
        </mj-text>
        <mj-text padding-left="16px" padding-bottom="8px">
          • <strong>Provide accurate descriptions.</strong> Detail key specs, state of condition, and features.
        </mj-text>
        <mj-text padding-left="16px" padding-bottom="8px">
          • <strong>Display correct pricing.</strong> Be transparent with pricing to avoid negotiation confusion.
        </mj-text>
        <mj-text padding-left="16px" padding-bottom="16px">
          • <strong>Update listings.</strong> Revise listings promptly whenever details or stock availability change.
        </mj-text>

        <mj-text padding-bottom="24px">
          Clear and accurate listings help build confidence in your business and create a better marketplace experience for everyone.
        </mj-text>

        <!-- CTA Button -->
        <mj-button
          background-color="#f59e0b"
          color="#ffffff"
          font-family="Outfit, sans-serif"
          font-size="16px"
          font-weight="700"
          href="https://carboncube-ke.com/seller/ads?utm_source=accurate_listings&utm_medium=email&utm_campaign=seller_communication"
          align="left"
          border-radius="8px"
          padding="12px 24px"
          padding-bottom="24px"
        >
          Manage My Listings
        </mj-button>

        <mj-text padding-bottom="32px">
          Regards,<br/>
          <strong>Carbon Cube Kenya</strong>
        </mj-text>
        
        <mj-divider border-width="1px" border-color="#e2e8f0" padding="20px 0px 20px" />
        
        <mj-text font-size="12px" color="#94a3b8">
          Nairobi, Kenya • <a href="https://carboncube-ke.com" style="color: #94a3b8; text-decoration: underline;">Visit Website</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
