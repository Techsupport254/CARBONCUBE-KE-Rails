<mjml>
  <mj-head>
    <mj-title>Verified Listings Get Priority | Carbon Cube Kenya</mj-title>
    <mj-font name="Outfit" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" />
    <mj-attributes>
      <mj-all
        font-family="Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        color="#334155"
        padding="0px"
      />
      <mj-text font-size="16px" line-height="26px" color="#334155" padding="0px" />
      <mj-section padding="0px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#ffffff" width="600px">
    <mj-section padding="40px 20px">
      <mj-column>
        <!-- Logo for branding -->
        <mj-image
          src="https://carboncube-ke.com/logo.png"
          width="32px"
          alt="Carbon Cube Kenya"
          align="left"
          padding-bottom="24px"
        />

        <mj-text padding-bottom="8px" font-weight="700" font-size="20px" line-height="28px" color="#1e293b">
          Quick question!
        </mj-text>

        <mj-text padding-bottom="16px">Dear {{first_name}},</mj-text>

        <mj-text padding-bottom="16px">
          Did you know <strong>verified listings get priority</strong> on Carbon Cube Kenya?
        </mj-text>

        <mj-text padding-bottom="16px">
          Show buyers your shop is 100% legit and safe to deal with — verified sellers earn more trust, more clicks, and more sales.
        </mj-text>

        <!-- Campaign image -->
        <mj-image
          src="https://carboncube-ke.com/email_banner_verified_listings.png"
          width="560px"
          alt="Verified listings get priority on Carbon Cube Kenya"
          padding-bottom="24px"
        />

        <mj-text padding-bottom="16px">
          Reply to this message and our team will get you verified today!
        </mj-text>

        <!-- CTA Button -->
        <mj-button
          background-color="#f59e0b"
          color="#ffffff"
          font-family="Outfit, sans-serif"
          font-size="16px"
          font-weight="700"
          href="{{whatsapp_url}}"
          align="left"
          border-radius="8px"
          padding="12px 24px"
          padding-bottom="24px"
        >
          Get Verified Today
        </mj-button>

        <mj-text font-size="14px" line-height="22px" color="#64748b" padding-bottom="32px">
          Prefer email? Just hit reply and we&apos;ll take it from there.
        </mj-text>

        <mj-text padding-bottom="32px">
          Regards,<br/>
          <strong>Carbon Cube Kenya</strong>
        </mj-text>

        <mj-divider border-width="1px" border-color="#e2e8f0" padding="20px 0px 20px" />

        <mj-text font-size="12px" color="#94a3b8">
          Nairobi, Kenya • <a href="https://carboncube-ke.com" style="color: #94a3b8; text-decoration: underline;">carboncube-ke.com</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
